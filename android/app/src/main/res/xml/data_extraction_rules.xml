<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the sign-in session (Firebase Auth tokens) and the
     encrypted local store out of cloud backups and device-to-device transfer.
     Its key never leaves this device's keystore, so restored copies would only
     be unreadable leftovers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
